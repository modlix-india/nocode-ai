      "name": "Repeator",
      "type": "ArrayRepeater",
      "properties": {
        "defaultData": {
          "value": [
            {
              "id": "faq_1",
              "question": "What makes Safario different from other safari tour agencies?",
              "answer": "They focus on curated safari experiences designed around each traveler. They work with expert guides, offer access to top wildlife reserves, and build personalized itineraries."
            },
            {
              "id": "faq_2",
              "question": "How do I book a safari trip with Safario?",
              "answer": "You can browse available tours online, submit an inquiry form, or speak directly with a travel specialist who helps finalize the itinerary."
            },
            {
              "id": "faq_3",
              "question": "What is included in a typical safari package?",
              "answer": "Packages usually include lodging, guided game drives, park fees, meals, airport transfers, and wildlife activities. Some include cultural visits or optional upgrades like balloon rides."
            },
            {
              "id": "faq_4",
              "question": "Which African destinations do you offer safari tours to?",
              "answer": "They operate in Tanzania, Kenya, South Africa, Botswana, Namibia, and Zimbabwe, covering places like the Serengeti, Maasai Mara, and Victoria Falls."
            },
            {
              "id": "faq_5",
              "question": "Are your safari tours suitable for families and children?",
              "answer": "Yes. They provide family-friendly options with activities for kids, suitable stays, and guides who know how to keep children engaged and safe."
            }
          ]
        }
      },
