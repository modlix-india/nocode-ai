      "body": "\n<!DOCTYPE html>\n<html lang=\"en\">\n\n<head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <meta http-equiv=\"X-UA-Compatible\" content=\"ie=edge\" />\n    <title>OTP Template</title>\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@100;200;300;400;500;600;700;800;900&display=swap\" rel=\"stylesheet\" />\n</head>\n\n<body style=\"font-family: Inter\">\n    <style>\n        .table {\n            width: 50%;\n           margin:30px auto;\n            border-collapse:seperate;\n          border-spacing:0;\n          table-layout:fixed;\n        }\n\n        .table td {\n            padding: 20px;\n            vertical-align: top;\n        }\n\n        .logo {\n            width: 141px;\n            height: 21px;\n        }\n\n        @media (max-width: 767px) {\n            .table {\n                width: 90%;\n            }\n        }\n    </style>\n  <center>\n    <table class=\"table\" style=\"max-width:600px;\">\n        <tr style=\"background-color: #ffffff;\">\n            <td style=\"padding: 30px; border-top-left-radius:4px; border-top-right-radius:4px; border-top:1px solid #0000000D; border-left:1px solid #0000000D; border-right:1px solid #0000000D;\">\n                <div style=\"background-image: url('https://modlix.com/api/files/static/file/SYSTEM/email/Frame<PHONE>.png'); background-size: cover; padding:30px;padding-left : 20px ;border-radius: 4px; margin-bottom: 10px;  background-position:center;\">\n                    <img class=\"logo\" src=\"https://dev.modlix.com/api/files/static/file/SYSTEM/cxapp/ Schedule A Call/modlix.png\" alt=\"\" title=\"Logo\" style=\"height:30px; width:150px;\" />\n                    \n               \n                </div>\n                <#if otpPurpose == \"REGISTRATION\">\n                <div style=\"margin-bottom: 20px;\">\n                    <p style=\"font-family: Inter; font-size: 14px; font-weight: 600; line-height: 14px; color: #333333CC; margin: 0;\">Hi User,</p>\n                </div>\n                <div style=\"margin-bottom: 10px;\">\n                    <p style=\"font-family: Inter; font-size: 14px; font-weight: 400; line-height: 20px; color: #333333CC; margin: 0;\">\n                        We received a request to verify your email address. Please use the OTP below to verify and proceed to set the PIN:                 </p>\n                </div>\n                <#elseif otpPurpose == \"PASSWORD_RESET\">\n                <div style=\"margin-bottom: 20px;\">\n                    <p style=\"font-family: Inter; font-size: 14px; font-weight: 600; line-height: 14px; color: #333333CC; margin: 0;\">Hi user,</p>\n                </div>\n                <div style=\"margin-bottom: 10px;\">\n                    <p style=\"font-family: Inter; font-size: 14px; font-weight: 400; line-height: 20px; color: #333333CC; margin: 0;\">\n                        We received a request to reset your PIN. To proceed, please verify your email by entering the OTP below:                 </p>\n                </div>\n                </#if>\n                \n                <div style=\"margin-bottom: 10px; background-color:rgba(0, 0, 0, 0.02); height:97px; width:100%; border-radius:10px; gap:15px; padding-top: 30px;\">\n                    <div>\n                    <p style=\"font-family: Inter; font-size: 16px; text-align: center; font-weight: 400; line-height: 20px; color: #333333CC; margin-top: 0;\">\n                        Your OTP Code\n                    </p>\n                    </div>\n                    <div>\n                    <p style=\"font-family: Inter; font-size: 26px; font-weight: 700; text-align: center; line-height: 26px; color: #34A853; margin: 0; letter-spacing: 30px; margin-left:23px;\">\n            