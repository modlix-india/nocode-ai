    "en": {
      "body": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Payment Receipt</title>\n  <style>\n     @page {\n      size: A4 portrait;\n      margin-bottom: 30px;\n     }\n    \n  </style>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"anonymous\" />\n    <link href='https://fonts.googleapis.com/css?family=Inter' rel='stylesheet'>\n</head>\n<body style=\"font-family: Arial, sans-serif; background-color: #ffffff; margin: 0; padding: 20px;\">\n  <div style=\"max-width: 800px; margin: auto; background-color: white; border-radius: 8px; padding-bottom: 30px; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);\">\n<div class=\"section-content grid\" style=\"padding-top:40px; padding-left:10px; padding-bottom:5px\">\n                                    <img src=${projectImageUrl} alt=\"project logo\" style=\"min-width:90px;max-width: 90px; min-height: 34px; max-height: 34px;margin-right:10px;\"/>\n                                    <img src=${builderImageUrl}  alt=\"builder logo\" style=\"min-width:74px;max-width: 74px;min-height: 34px; max-height: 34px;\"/>\n                                </div>\n    <div style=\"position: relative; text-align: center; padding-top:0px\">\n     \n      <h1 style=\"margin-top: 10px; font-family:'Plus Jakarta Sans'; font-weight:600; font-size: 16px; line-height:16px; color: #08705C\">E-Payment Receipt</h1>\n      <p style=\"margin: 0; font-size: 14px; line-height: 14px; font-family:'Inter'; font-weight:700; color: #666666;\">E-Receipt no. \n        <span style=\"font-size: 14px; line-height: 14px; font-family: 'sans-serif'; color: #000000; font-weight: 700;\">${receiptNo}</span>\n      </p>\n    </div>\n\n    <!-- Details Table -->\n    <table style=\"border-collapse: separate; margin-top: 20px; margin-left: 10px; table-layout:fixed;\">\n      <tr>\n        <th style=\"width:250px; padding: 10px 0px 10px 0px; text-align: left; white-space: nowrap; color: #999999; font-family: Inter; font-size: 12px; font-weight: 500; line-height: 12px;\">BOOKING NAME</th>\n        <th style=\"width:200px; padding: 10px 0px 10px 0px; text-align: left; white-space: nowrap; color: #999999; font-family: Inter; font-size: 12px; font-weight: 500; line-height: 12px;\">TOTAL AMOUNT PAID</th>\n        <th style=\"width:200px; padding: 10px 0px 10px 0px; text-align: left; white-space: nowrap; color: #999999; font-family: Inter; font-size: 12px; font-weight: 500; line-height: 12px;\">DATE</th>\n      </tr>\n      <tr>\n        <td style=\"width:250px; padding: 0px 0px 10px 0px; word-break: break-all; text-align: left; color: #000000; font-family: Inter; font-size: 16px; font-weight:700; line-height:16px;\">${bookingName}</td>\n        <td style=\"width:200px; padding: 0px 0px 10px 0px; text-align: left; white-space: nowrap; color: #000000; font-family: Inter; font-size: 16px; font-weight:700; line-height:16px;\">Rs  ${totalAmountPaid}</td>\n        <td style=\"width:200px; padding: 0px 0px 10px 0px; text-align: left; white-space: nowrap; color: #000000; font-family: Inter; font-size: 16px; font-weight:700; line-height:16px;\">${date}</td>\n      </tr>\n    </table>\n\n    <!-- Purchase Summary -->\n    <h2 style=\"color:#999999; font-family: Inter; font-size: 12px; font-weight: 600; line-height: 12px; margin-left:10px; margin-bottom:10px;\">PURCHASE SUMMARY</h2>\n<div style=\"width:650px; background-color:#F7F9FC; padding:20px 0px 20px 0px; margin-left:10px; margin-right:60px; border-radius:10px;\">\n  <table style=\"margin-left:22px; margin-right:60px; background-color:#F7F9FC; width:550px; table-layout:fixed; border-collapse:collapse;\">\n    <tr>\n      <th style=\"color:#999999; font-family: Inter; font-size: 12px; font-weight: 500; line-height: 12px; padding:10px; border-bottom:1px solid #ddd; border-right:1px solid #ddd; text-align:left;\">PROJECT</th>\n      <th style=\"color:#999999; font-family: Inter; font-size: 12px; font-weight: 500; line-height: 12px; padding:10px; border-bottom:1px solid #ddd; border-right:1px solid #ddd; text-align:left; white-space:nowrap; padding-left:20px;\">TOTAL UNIT COST</th>\n\n<#if area?has_content>\n      <th style=\"color:#999999; font-family: Inter; font-size: 12px; font-weight: 500; line-height: 12px; padding:10px; border-bottom:1px solid #ddd; text-align:left; border-right:1px solid #ddd; padding-left:20px;\">No. of Sq Ft</th>\n</#if> \n<#if unitNumber?has_content>\n <th style=\"color:#999999; font-family: Inter; font-size: 12px; font-weight: 500; line-height: 12px; padding:10px; border-bottom:1px solid #ddd; text-align:left; border-right:1px solid #ddd; padding-left:20px;\">UNIT NO</th>\n</#if>\n<#if superBuiltupArea?has_content>\n <th style=\"color:#999999; font-family: Inter; font-size: 12px; font-weight: 500; line-height: 12px; padding:10px; text-align:left; padding-left:20px;\">SBA</th>\n</#if>\n<#if saleableArea?has_content>\n <th style=\"color:#999999; font-family: Inter; font-size: 12px; border-left:1px solid #ddd; font-weight: 500; line-height: 12px; padding:10px; border-bottom:1px solid #ddd; text-align:left; border-right:none; padding-left:20px;\">SALEABLE AREA</th>\n</#if>\n    </tr>\n    <tr>\n      <td style=\"color:#000000; font-family: Inter; font-size: 14px; font-weight: 600; line-height: 14px; padding:10px; border-top:1px solid #ddd; border-right:1px solid #ddd; text-align:left;\">${projectName}</td>\n      <td style=\"color:#000000; font-family: Inter; font-size: 14px; font-weight: 600; line-height: 14px; padding:10px; border-top:1px solid #ddd; border-right:1px solid #ddd; text-align:left; padding-left:20px;\">Rs  ${amountInvested}</td>\n<#if area?has_content>\n      <td style=\"color:#000000; font-family: Inter; font-size: 14px; font-weight: 600; line-height: 14px; padding:10px; border-top:1px solid #ddd; text-align:left; border-right:1px solid #ddd; padding-left:20px;\">${area}</td>\n</#if> \n<#if unitNumber?has_content>\n      <td style=\"color:#000000; font-family: Inter; font-size: 14px; font-weight: 600; line-height: 14px; padding:10px; border-top:1px solid #ddd; text-align:left; border-right:1px solid #ddd; padding-left:20px;\">${unitNumber}</td>\n</#if>\n<#if superBuiltupArea?has_content>\n      <td style=\"color:#000000; font-family: Inter; font-size: 14px; font-weight: 600; line-height: 14px; padding:10px; border-top:1px solid #ddd; text-align:left; padding-left:20px;\">${superBuiltupArea}</td>\n</#if>\n<#if saleableArea?has_content>\n      <td style=\"color:#000000; font-family: Inter; font-size: 14px; font-weight: 600; line-height: 14px; padding:10px; border-top:1px solid #ddd; text-align:left;border-left:1px solid #ddd; border-right:none; padding-left:20px;\">${saleableArea}</td>\n</#if>\n\n    </tr>\n  </table>\n</div>\n\n<h2 style=\"margin-top:40px; color:#999999; font-family: Inter; font-size: 12px; font-weight: 400; line-height: 12px; margin-left:10px; margin-bottom:10px;\">The below payment(s) have been made via the following modes:-</h2>\n<div style=\"background-color:#F7F9FC; width:700px; padding:10px 0px 10px 0px; margin-left:10px; margin-right:60px; border-radius:10px;\">\n\n\n  <table style=\"width:auto; table-layout:auto; margin-left:20px; margin-top:20px; background-color:#F7F9FC; border-collapse:collapse; border-radius:10px; padding:1px 0px 20px 0px;\">\n    <tr>\n        <th style=\"color:#999999; width:60px; font-family: Inter; font-size: 12px; font-weight: 500; line-height: 12px; padding:10px; border-bottom:1px solid #ddd; border-right:1px solid #ddd; text-align:left; padding-left:0px; padding-right:0px;\">MODE</th>\n        <th style=\"color:#999999; font-family: Inter; font-size: 12px; font-weight: 500; line-height: 12px; padding:10px; border-bottom:1px solid #ddd; border-right:1px solid #ddd; text-align:left; padding-left:20px;\">DATE</th>\n        <th style=\"color:#999999; font-family: Inter; font-size: 12px; font-weight: 500; line-height: 12px; padding:10px; border-bottom:1px solid #ddd; border-right:1px solid #ddd; text-align:left; padding-left:20px;\">TXN ID</th>\n        <th style=\"color:#999999; font-family: Inter; font-size: 12px; font-weight: 500; line-height: 12px; padding:10px; border-bottom:1px solid #ddd; border-right:1px solid #ddd; text-align:left; padding-left:20px;\">TXN TYPE</th>\n        <th style=\"color:#999999; font-family: Inter; font-size: 12px; font-weight: 500; line-height: 12px; padding:10px; border-bottom:1px solid #ddd; text-align:left; padding-left:20px; border-right:none;\">AMOUNT INR</th>\n      </tr>\n<#list transactionDetails as details>\n    <tr>\n        <td style=\"color:#000000; font-family: Inter; font-size: 14px; font-weight: 600; line-height: 14px; padding:10px; border-top:1px solid #ddd; border-right:1px solid #ddd; text-align:left; padding-left:0px;\">${details.paymentMethod}</td>\n        <td style=\"color:#000000; font-family: Inter; font-size: 14px; font-weight: 600; line-height: 14px; padding:10px; border-top:1px solid #ddd; border-right:1px solid #ddd; text-align:left; padding-left:20px;\">${details.paidOn}</td>\n        <td style=\"color:#000000; font-family: Inter; font-size: 14px; font-weight: 600; line-height: 14px; padding:10px; border-top:1px solid #ddd; border-right:1px solid #ddd; text-align:left; padding-left:20px; white-space: normal;\">${details.transactionId}</td>\n        <td style=\"color:#000000; font-family: Inter; font-size: 14px; font-weight: 600; line-height: 14px; padding:10px; border-top:1px solid #ddd; border-right:1px solid #ddd; text-align:left; padding-left:20px; white-space: normal;\">\n          <#if details.transactionType??>\n            ${details.transactionType}\n          <#else>\n            PAID\n          </#if>\n\n          \n        </td>\n        <td style=\"color:#000000; font-family: Inter; font-size: 14px; font-weight: 600; line-height: 14px; padding:10px; border-top:1px solid #ddd; text-align:left; padding-left:20px; border-right:none;\">Rs ${details.amountPaid}</td>\n    </tr>\n</#list>\n</table>\n</div>\n<div style=\"margin-top: 20px; font-family:Inter; font-size: 12px; color: #555;\">\n    <p style=\"font-family: Inter; font-size: 12px; font-weight: 400; line-height: 22px; margin-left: 10px;\">${description}<!-- We hereby acknowledge and thank you for the above payments. --></p>\n  </div>\n  <p style=\"margin-top: 24px; margin-left: 40px; color: #00000066; font-family: Inter; font-size: 12px; font-weight: 600; line-height: 12px;\">NOTE:</p>\n<#list notes as notesArray>\n  <div style=\"margin-left: 70px; margin-bottom: 0px; font-size: 11px; color: #888;\">\n    <p style=\"color: #000000;  margin: 0; padding: 0; font-family: Inter; font-size: 14px; font-weight: 400; line-height: 22px; white-space: nowrap; display: inline-block;\"> ${notesArray?index + 1}. ${notesArray.note}</p> \n  </div>\n</#list>\n    </div>\n</body>\n</html>",
      "subject": "Receiptstemplate"
    }
