  "eventFunctions": {
    "getUserDetail": {
      "name": "getUserDetail",
      "namespace": "UIEngine",
      "parameters": {},
      "events": {
        "output": {
          "name": "output",
          "parameters": {
            "userDetailData": {
              "name": "userDetailData",
              "type": "Object"
            }
          }
        }
      },
      "steps": {
        "getData": {
          "statementName": "getData",
          "namespace": "UIEngine",
          "name": "FetchData",
          "parameterMap": {
            "url": {
              "getuserdetailsurl": {
                "key": "getuserdetailsurl",
                "type": "VALUE",
                "value": "api/core/data/UserStorage/useid"
              }
            },
            "pathParams": {
              "getUserdetailpathparams": {
                "key": "getUserdetailpathparams",
                "type": "VALUE",
                "value": {
                  "useid": {
                    "location": {
                      "type": "EXPRESSION",
                      "expression": "Store.urlDetails.pathParts[1]??''"
                    }
                  }
                }
              }
            }
          }
        },
        "setUserDetailsData": {
          "statementName": "setUserDetailsData",
          "namespace": "UIEngine",
          "name": "SetStore",
          "parameterMap": {
            "path": {
              "setUserDetailsDataPath": {
                "key": "setUserDetailsDataPath",
                "type": "VALUE",
                "value": "Page.user"
              }
            },
            "value": {
              "setUserDetailsDataValue": {
                "key": "setUserDetailsDataValue",
                "type": "EXPRESSION",
                "expression": "Steps.getData.output.data"
              }
            }
          },
          "dependentStatements": {
            "Steps__d-o-t__getData__d-o-t__output": true
          }
        },
        "genOutput": {
          "statementName": "genOutput",
          "namespace": "System",
          "name": "GenerateEvent",
          "parameterMap": {
            "eventName": {
              "genOutputEventName": {
                "key": "genOutputEventName",
                "type": "VALUE",
                "value": "output"
              }
            },
            "results": {
              "genOutputResults": {
                "key": "genOutputResults",
                "type": "VALUE",
                "value": {
                  "name": "userData",
                  "value": {
                    "isExpression": true,
                    "value": "Steps.setUserDetailsData.output.data"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
